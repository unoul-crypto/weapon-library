# Original bundled glTF demonstrates a model with an animated magazine.
model = models/rifle.gltf
mass_kg = 3.5
walk_sway_multiplier = 1
turn_sway_multiplier = 1
aimed_sway_multiplier = 0.25
# Aim drift at full ADS. Amplitude is yaw followed by pitch, in radians.
aimed_sway_amplitude_rad = 0.0035 0.0025
aimed_sway_frequency_hz = 0.55
projectiles_per_shot = 1
lower_seconds = 0.20
raise_to_ready_seconds = 0.24
raise_to_aim_seconds = 0.36
lower_key = 0  0 0 0              0 0 0
lower_key = 0.5  0.02 -0.04 -0.02  12 -8 5
lower_key = 1  0.06 -0.11 -0.04   22 -18 12
reload_clip = Reload
model_scale = 1 1 1
model_offset = 0 0 0
model_rotation = 0 0 0
hip_offset = 0.24 -0.22 0.58
aimed_offset = 0 -0.065 0.5
muzzle_offset = 0 0 0.4
reload_interpolation = smooth
reload_key = 0    0 0 0           0 0 0
reload_key = 0.2  -0.04 0.12 0.04  5 -12 28
reload_key = 0.7  -0.04 0.12 0.04  5 -12 28
reload_key = 1    0 0 0           0 0 0
